#!/bin/sh
# IHS Practice Files — sample hook.
# Copy to .git/hooks/pre-commit if you want this clone to block image commits.
# Do not run git config. Do not commit photos, scans, or .part files.

blocked=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  base=$(printf '%s' "$f" | tr 'A-Z' 'a-z')
  case "$base" in
    *.jpg|*.jpeg|*.png|*.webp|*.heic|*.part)
      echo "IHS pre-commit: blocked image/part file: $f" >&2
      blocked=1
      ;;
  esac
done <<EOF
$(git diff --cached --name-only)
EOF

if [ "$blocked" -ne 0 ]; then
  echo "Do not commit photos or .part files. They are not part of this public shell." >&2
  exit 1
fi
exit 0
